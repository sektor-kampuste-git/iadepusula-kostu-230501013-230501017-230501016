# EVREN OpenAI-compatible gateway. Never commit a real key.
LLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
LLM_API_KEY=
LLM_MODEL=qwen3-vl-30b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
# Optional semantic RAG; default lexical retrieval runs offline.
RAG_BACKEND=lexical
EMBEDDING_MODEL=qwen3-embedding-8b

# Member 2 bounded draft workflow (4 local tools + up to 2 model attempts).
AGENT_MAX_STEPS=6
AGENT_MAX_MODEL_CALLS=2
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_USD=0.015
AGENT_MAX_SECONDS=90
# Explicit verified prices or clearly labelled assumptions. Blank = no model call.
# PRICE_KIND: provider_published or user_assumption. Never use test prices live.
PRICE_INPUT_USD_PER_MILLION=
PRICE_OUTPUT_USD_PER_MILLION=
PRICE_CHECKED_ON=
PRICE_SOURCE=
PRICE_KIND=
