# EVREN OpenAI-compatible gateway. Never commit a real key.
LLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
LLM_API_KEY=
LLM_MODEL=auto
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
# Optional semantic RAG; default lexical retrieval runs offline.
RAG_BACKEND=lexical
EMBEDDING_MODEL=ytu-ce-cosmos/turkish-e5-large
